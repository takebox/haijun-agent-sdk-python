# Dockerfile for running SDK tests in a containerized environment
# This helps catch Docker-specific issues like #406

FROM python:3.12-slim

# Docker's default `RUN` shell is `/bin/sh -c`, which reports only the last
# status of a pipeline: a failed `curl` would be masked by a successful `bash`,
# leaving a green build with no CLI installed. Fail on any element instead.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install dependencies for Haijun CLI and git (needed for some tests)
RUN apt-get update && apt-get install -y \
    curl \
    git \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install the Haijun Code fork binary DIRECTLY.
#
# install-v2.sh ends by running `haijun install`, whose launcher step can replace
# the fork binary with the stock Takebox AI CLI pulled from npm (observed as
# "2.1.270 (Haijun Code)" inside the container). That stock CLI ignores the
# HAIJUN_* env contract and reports "Not logged in" for every e2e test. Fetching
# the platform tarball and linking it ourselves keeps the fork intact.
#
# Fetched from the worker's *.workers.dev host (separate cache namespace) so a
# stale 404 at a Cloudflare edge on downloads.haijun.my.id can't break the build.
# Every request uses a fresh high-entropy nonce (?nocache=$RANDOM$(date +%s%N)):
# second-resolution timestamps collide on retries and the edge then serves a
# cached 404 for the identical URL (observed with the older ?v=$(date +%s)).
ARG HAIJUN_VERSION=0.1.0
ENV HAIJUN_DOWNLOAD_BASE_URL=https://cli.rompahjunaidi.workers.dev/cli
# PATH for the up-next RUN step MUST be declared BEFORE the step that runs
# `haijun -v`, otherwise the shell can only find the CLI at an absolute path
# ("haijun: command not found" — the prior ordering bug).
ENV PATH="/root/.local/bin:$PATH"
RUN set -euo pipefail; \
    BASE="${HAIJUN_DOWNLOAD_BASE_URL}"; \
    MAN="$(curl -fsSL "$BASE/${HAIJUN_VERSION}/manifest.v2.json?nocache=$RANDOM$(date +%s%N)" || curl -fsSL "https://downloads.haijun.my.id/cli/${HAIJUN_VERSION}/manifest.v2.json?nocache=$RANDOM$(date +%s%N)")"; \
    PARTS="$(printf '%s' "$MAN" | python -c 'import json,sys; print(json.load(sys.stdin)["platforms"]["linux-x64"]["parts"])')"; \
    SHA="$(printf '%s' "$MAN" | python -c 'import json,sys; print(json.load(sys.stdin)["platforms"]["linux-x64"]["checksum"])')"; \
    DIR="$HOME/.haijun-code/bin"; mkdir -p "$DIR" "$HOME/.local/bin"; \
    OUT="$DIR/haijun-${HAIJUN_VERSION}-linux-x64"; : > "$OUT"; \
    i=0; while [ "$i" -lt "$PARTS" ]; do \
        N="$RANDOM$RANDOM$(date +%s%N)"; \
        curl -fsSL "$BASE/${HAIJUN_VERSION}/linux-x64/haijun.part$i?nocache=$N" >> "$OUT" || curl -fsSL "https://downloads.haijun.my.id/cli/${HAIJUN_VERSION}/linux-x64/haijun.part$i?nocache=$RANDOM$(date +%s%N)" >> "$OUT"; \
        i=$((i+1)); \
    done; \
    echo "$SHA  $OUT" | sha256sum -c -; \
    chmod +x "$OUT"; \
    ln -sf "$OUT" "$HOME/.local/bin/haijun"; \
    haijun -v | grep -q "Haijun Code"

# Set up working directory
WORKDIR /app

# Copy the SDK source
COPY . .

# Install SDK with dev dependencies
RUN pip install -e ".[dev]"

# Verify CLI installation
RUN haijun -v

# Trust the workspace so Haijun Code honors this repo's project-scoped
# permission grants and does not emit untrusted-workspace diagnostics on
# stderr. Must come after `haijun -v`, which is the last step that writes
# ~/.haijun.json. Trust is keyed on the WORKDIR (/app; .dockerignore omits
# .git), so it only applies when the container runs the source baked in here
# from /app -- a bind-mounted checkout at another path is not covered.
# See scripts/trust_workspace.py.
RUN python scripts/trust_workspace.py

# Default: run unit tests
CMD ["python", "-m", "pytest", "tests/", "-v"]
