# Dockerfile for running SDK tests in a containerized environment
# This helps catch Docker-specific issues like #406

FROM python:3.12-slim

# Docker's default `RUN` shell is `/bin/sh -c`, which reports only the last
# status of a pipeline: a failed `curl` would be masked by a successful `bash`,
# leaving a green build with no CLI installed. Fail on any element instead.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install dependencies for Haijun CLI and git (needed for some tests)
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Haijun Code CLI
# Fetched from the worker's *.workers.dev host (separate cache namespace) so a
# stale 404 at a Cloudflare edge on downloads.haijun.my.id can't break the build.
RUN bash -c 'export HAIJUN_DOWNLOAD_BASE_URL=https://cli.rompahjunaidi.workers.dev/cli; curl -fsSL https://cli.rompahjunaidi.workers.dev/cli/install-v2.sh | bash'
ENV PATH="/root/.local/bin:$PATH"

# Set up working directory
WORKDIR /app

# Copy the SDK source
COPY . .

# Install SDK with dev dependencies
RUN pip install -e ".[dev]"

# Verify CLI installation
RUN haijun -v

# Trust the workspace so Haijun Code honors this repo's project-scoped
# permission grants and does not emit untrusted-workspace diagnostics on
# stderr. Must come after `haijun -v`, which is the last step that writes
# ~/.haijun.json. Trust is keyed on the WORKDIR (/app; .dockerignore omits
# .git), so it only applies when the container runs the source baked in here
# from /app -- a bind-mounted checkout at another path is not covered.
# See scripts/trust_workspace.py.
RUN python scripts/trust_workspace.py

# Default: run unit tests
CMD ["python", "-m", "pytest", "tests/", "-v"]
